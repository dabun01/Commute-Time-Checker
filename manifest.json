{
  "manifest_version": 3,
  "name": "Commute Time Checker",
  "version": "1.0.0",
  "description": "See drive times from any apartment listing to your work, church, and other saved places.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check commute times"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://routes.googleapis.com/*",
    "https://places.googleapis.com/*"
  ]
}